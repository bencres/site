# Caching and types for Netlify / Cloudflare Pages (scripts/serve.mjs reads it too).
# One path per rule, and no catch-all: both hosts merge the headers of every rule
# that matches, so overlapping Cache-Control rules would combine.

# the Rive runtime lives in a folder named for its version, and the fonts never change
/shared/vendor/2.51.0/*
  Cache-Control: public, max-age=31536000, immutable

/shared/vendor/2.51.0/rive.wasm
  Content-Type: application/wasm

/shared/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# the paintings (and the hill's stills) are rebuilt in place, so they're kept a short while
/riv/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/octet-stream

/shire-ii/stills/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# pages are always rechecked, so a new build shows at once
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/shire-ii/
  Cache-Control: no-cache

/shire-ii/index.html
  Cache-Control: no-cache

/shire-ii/blog/:slug/
  Cache-Control: no-cache

/shire-ii/blog/:slug/index.html
  Cache-Control: no-cache
